# Server
NODE_ENV=production
PORT=80
HOST=0.0.0.0

# Required in production (replace with real values on server)
SESSION_SECRET=replace-with-random-secret
API_KEY=replace-with-api-key

# Optional (defaults in config)
# API_PORT=3000
# CORS_ORIGIN=https://beresta.one

# Optional: logging, storage, Bluetooth
# LOG_LEVEL=warn
# DATA_DIR=/var/lib/beresta/data
